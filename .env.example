# Configuración de acceso privado. No uses estos valores de ejemplo en producción.
APP_PASSWORD=cambia-esto-por-una-frase-larga-y-unica
SESSION_SECRET=genera-un-secreto-aleatorio-de-al-menos-32-caracteres

# Vercel Blob privado: al conectar el store al proyecto, Vercel configura
# BLOB_STORE_ID y VERCEL_OIDC_TOKEN automáticamente en Functions.
# Fuera de Vercel, el SDK puede requerir BLOB_READ_WRITE_TOKEN.
